{
  // Generated by `npm run dev:prepare` — includes Nuxt auto-import globals
  // (useCommunityConfig, useAsyncData, …) for Volar / the TS language service.
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    // `.nuxt/tsconfig.json` sets `types: []`; re-enable Node for module.ts (`node:fs` / `node:path`).
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "node_modules",
    "playground"
  ]
}
