{
  "name": "@blueshoe/community-widget",
  "version": "0.3.0",
  "type": "module",
  "description": "API-First Blueshoe Community-System Web Components",
  "main": "./dist/community-widget.umd.cjs",
  "module": "./dist/community-widget.js",
  "exports": {
    ".": {
      "import": "./dist/community-widget.js",
      "require": "./dist/community-widget.umd.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "blueshoe-community-init": "bin/init.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blueshoe/blueshoe-comments.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.1.2",
    "altcha": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": "Blueshoe",
  "license": "MIT"
}
