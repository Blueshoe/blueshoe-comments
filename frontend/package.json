{
  "name": "@blueshoe/community-widget",
  "type": "module",
  "version": "1.0.3",
  "description": "Nuxt 4 module for the Blueshoe Community comment & reaction system",
  "author": "Blueshoe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blueshoe/blueshoe-comments.git",
    "directory": "frontend"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "build:css": "sass src/runtime/assets/scss/index.scss dist/runtime/assets/css/community.css --style=compressed --no-source-map",
    "prepack": "npm run build",
    "build": "nuxt-module-build prepare && nuxt-module-build build && npm run build:css",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "altcha": "^3.6.0",
    "defu": "^6.1.4",
    "dompurify": "^3.5.0",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@nuxt/eslint": "^1.0.0",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.11",
    "eslint": "^9.0.0",
    "eslint-plugin-format": "^1.0.0",
    "nuxt": "^4.0.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
