# -----------------------------------------------------------------------------
# Blueshoe Comments - Production & Development Environment Configuration
# -----------------------------------------------------------------------------

# Application Port (Mapped on host: 8079)
WEB_PORT=8079

# Django Settings
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Host routing & Security (Multi-Domain Setup)
ALLOWED_HOSTS=community.blueshoe.de,community.blueshoe.io,community.django-hurricane.io,community.gefyra.dev,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://www.blueshoe.de,https://blueshoe.de,https://www.blueshoe.io,https://blueshoe.io,https://django-hurricane.io,https://gefyra.dev,https://www.gefyra.dev,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://community.blueshoe.de,https://community.blueshoe.io,https://community.django-hurricane.io,https://community.gefyra.dev,https://www.blueshoe.de,https://www.blueshoe.io,http://localhost:3000

# Database Configuration (PostgreSQL in production)
POSTGRES_DB=community
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
DATABASE_URL=postgres://postgres:postgres_secure_password_here@db:5432/community

# Redis Cache & Sessions (In-Memory Performance)
CACHE_URL=redis://redis:6379/1

# Background Tasks Framework (ImmediateBackend for sync execution, or worker backend in production)
TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# Email Settings (SMTP via Django Task Framework)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=postmaster@blueshoe.de
EMAIL_HOST_PASSWORD=smtp_password_here
DEFAULT_FROM_EMAIL=noreply@blueshoe.de

# AI Moderation (Google Gemini 3.8 Flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Optional Non-blocking Moderation Webhook (Slack / Mattermost)
MODERATION_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional Static Site Rebuild Trigger Webhook (CI / GitHub Actions)
STATIC_BUILD_WEBHOOK_URL=
